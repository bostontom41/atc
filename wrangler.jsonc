// Cloudflare settings: serve the static website in ./public
{
  "name": "atc",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "atcflorida.com", "custom_domain": true },
    { "pattern": "www.atcflorida.com", "custom_domain": true },
    { "pattern": "atc.tdh-sandbox.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
